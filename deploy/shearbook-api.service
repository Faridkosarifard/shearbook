[Unit]
Description=ShearBook API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
Group={{GROUP}}
WorkingDirectory={{WORKDIR}}
EnvironmentFile={{WORKDIR}}/.env
# Factory app: two workers is enough for a single salon on a Pi.
ExecStart={{WORKDIR}}/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 "shearbook.app:create_app()"
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
