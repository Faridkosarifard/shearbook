[Unit]
Description=ShearBook WhatsApp bot
After=network-online.target shearbook-api.service
Wants=network-online.target
Requires=shearbook-api.service

[Service]
Type=simple
User={{USER}}
Group={{GROUP}}
WorkingDirectory={{WORKDIR}}/bot
EnvironmentFile={{WORKDIR}}/.env
Environment=NODE_ENV=production
# Chromium is required by whatsapp-web.js (unofficial WhatsApp Web client).
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
