# ShearBook configuration
# Copy this file to .env and fill in the values. Never commit .env.

# --- required secrets (generate long random strings) ---
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-different-long-random-string
BOT_TOKEN=change-me-shared-token-for-the-whatsapp-bridge
WHATSAPP_ADMIN_TOKEN=change-me-token-for-the-whatsapp-admin-api

# --- database ---
# SQLite is the default and is recommended on a single Raspberry Pi.
# Use PostgreSQL if you prefer: postgresql+psycopg://user:pass@localhost:5432/shearbook
DATABASE_URL=sqlite:///data/shearbook.db

# --- salon ---
TIMEZONE=Europe/Berlin
# Customer-facing WhatsApp locale: de or en
CUSTOMER_LOCALE=de
# Public holidays: ISO country, optional subdivision (DE-BW, DE-RP, DE-BY, ...).
# Leave HOLIDAY_REGION empty for nationwide holidays only.
HOLIDAY_COUNTRY=DE
HOLIDAY_REGION=
# Prefix for reservation codes, e.g. SB-0814-4821
RESERVATION_PREFIX=SB
# Slot grid in minutes
SLOT_STEP_MIN=30

# --- calendar ---
# "local" stores busy times in the database (no Google account needed).
# "google" syncs each stylist to a Google Calendar.
CALENDAR_BACKEND=local
GOOGLE_CREDENTIALS_PATH=credentials/credentials.json
GOOGLE_TOKEN_PATH=credentials/token.json
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar

# --- HTTP ---
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000
# Set COOKIE_SECURE=1 when serving over HTTPS
COOKIE_SECURE=0
COOKIE_SAMESITE=Lax
JWT_EXP_HOURS=8

# --- paths ---
# Directory that holds the built admin UI (admin/dist after `npm run build`)
ADMIN_DIST=admin/dist
# WhatsApp bridge admin API (QR / status). Flask proxies /wa/* here.
WHATSAPP_ADMIN_URL=http://127.0.0.1:5001

# --- WhatsApp bot process ---
BACKEND_URL=http://127.0.0.1:8000
WHATSAPP_ADMIN_PORT=5001
WHATSAPP_ADMIN_CORS=*
SETTINGS_TTL_MS=60000
LOG_LEVEL=info
# Optional allow-list of WhatsApp numbers that may talk to the bot (comma-separated, digits only).
# Leave empty to accept any customer that is not on the block list.
# ALLOWED_NUMBERS=

# --- admin UI (Vite dev only) ---
# VITE_API_URL=/api
# VITE_WA_ADMIN_TOKEN=
